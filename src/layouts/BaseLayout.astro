---
import Footer from '@hagicode/hagilight/Footer';
import SEOHead from '@hagicode/hagilight/SEOHead';
import { resolveFaviconHeadEntry } from '@hagicode/hagilight-core/favicon';
import sharedFaviconUrl from '@hagicode/hagilight-core/favicon.ico';
import ThemeRuntime from '@/components/ThemeRuntime.astro';
import { Notice } from '@/components/course/Notice';
import { SiteHeader } from '@/components/course/SiteHeader';
import type { SwitcherItem } from '@/components/course/types';
import {
  DEFAULT_LOCALE,
  LOCALE_NATIVE_NAMES,
  SITE_DESCRIPTION,
  SITE_NAME,
  SUPPORTED_LOCALES,
} from '@/config/site';
import { courses } from '@/courses/registry';
import { uiStringsFor } from '@/i18n/ui';
import { routePath, switchLocale, type Route } from '@/lib/routes';
import { THEME_STORAGE_KEY } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  route: Route;
  // How wide the content column is inside the main pane: the reading column for a lesson (a little wider on very wide
  // screens, where the lesson text also grows), a medium column for a course overview, and a wide one for the course list.
  width?: 'reading' | 'medium' | 'wide';
}

const { title = SITE_NAME, description = SITE_DESCRIPTION, route, width = 'reading' } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
// A conditional slot still counts as present in Astro, so the rail is judged by its rendered content.
const railHtml = Astro.slots.has('rail') ? (await Astro.slots.render('rail')).trim() : '';
const hasRail = railHtml !== '';
const columnWidth = { reading: 'max-w-2xl 3xl:max-w-[46rem]', medium: 'max-w-3xl', wide: 'max-w-5xl' }[width];
const locale = route.locale;
const ui = uiStringsFor(locale);

// hagilightFavicon() only edits Astro's config head, which this layout does not render. The shared
// icon is therefore supplied here, through SEOHead, so the page links it.
const faviconEntry = resolveFaviconHeadEntry([], { href: sharedFaviconUrl });

// hreflang alternates: the same page in each locale, plus x-default pointing at the en-US page.
const pageUrl = (target: Route) => new URL(routePath(target), Astro.site).href;
const alternates = [
  ...SUPPORTED_LOCALES.map((code) => ({
    tag: 'link' as const,
    attrs: { rel: 'alternate', hreflang: code, href: pageUrl(switchLocale(route, code)) },
  })),
  {
    tag: 'link' as const,
    attrs: { rel: 'alternate', hreflang: 'x-default', href: pageUrl(switchLocale(route, DEFAULT_LOCALE)) },
  },
];

const courseSwitcher: SwitcherItem[] = courses.map((course) => ({
  id: course.id,
  label: course.title[locale],
  href: routePath({ kind: 'course', locale, courseId: course.id }),
  current: route.kind !== 'home' && route.courseId === course.id,
}));
const languageSwitcher: SwitcherItem[] = SUPPORTED_LOCALES.map((code) => ({
  id: code,
  label: LOCALE_NATIVE_NAMES[code],
  href: routePath(switchLocale(route, code)),
  current: code === locale,
}));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Applies the reader's stored theme before the stylesheet paints. Without a valid stored value it follows the system.
         If it cannot run, data-theme stays unset and the prefers-color-scheme block in global.css decides. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      (function () {
        var theme = null;
        try {
          var stored = window.localStorage.getItem(storageKey);
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (error) {}
        if (theme === null) {
          try {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch (error) {}
        }
        if (theme !== null) document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
    <SEOHead
      site={Astro.site}
      page={{ title, description }}
      head={[...(faviconEntry ? [faviconEntry] : []), ...alternates]}
      siteSeo={{ title: SITE_NAME, description: SITE_DESCRIPTION }}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader
      siteName={SITE_NAME}
      homeHref={routePath({ kind: 'home', locale })}
      courseLabel={ui.courseSwitcherLabel}
      courses={courseSwitcher}
      languageLabel={ui.languageSwitcherLabel}
      languages={languageSwitcher}
      themeLabel={ui.themeToggleLabel}
    />
    <!-- The workbench: an optional sidebar pane beside the main pane. The sidebar stacks above main below lg. From xl the
         panes sit on three tracks: the outer two flex, so the outline and the optional "On this page" rail stay beside the
         reading column and the whole group centres on a wide screen, while the sidebar keeps its hairline against the column. -->
    <div
      class:list={[
        'flex-1',
        hasSidebar &&
          'lg:grid lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[minmax(18rem,1fr)_minmax(0,47rem)_minmax(15rem,1fr)] 3xl:grid-cols-[minmax(18rem,1fr)_minmax(0,51rem)_minmax(15rem,1fr)]',
      ]}
    >
      {hasSidebar && (
        <aside class="border-b border-border px-4 py-3 lg:sticky lg:top-12 lg:h-[calc(100dvh-3rem)] lg:self-start lg:overflow-y-auto lg:border-r lg:border-b-0 lg:px-0 lg:py-5">
          <div class="lg:ml-auto lg:w-72 lg:px-4">
            <slot name="sidebar" />
          </div>
        </aside>
      )}
      <main class="min-w-0 max-w-none px-4 py-8 lg:px-10 lg:py-10">
        <div class:list={['mx-auto w-full', columnWidth]}>
          <Notice storage hidden>{ui.storageUnavailableNotice}</Notice>
          <slot />
        </div>
      </main>
      {hasRail && (
        <aside class="hidden xl:sticky xl:top-12 xl:block xl:max-h-[calc(100dvh-3rem)] xl:self-start xl:overflow-y-auto xl:py-10 xl:pr-4">
          <div class="max-w-60">
            <Fragment set:html={railHtml} />
          </div>
        </aside>
      )}
    </div>
    <Footer locale={locale} />
    <ThemeRuntime />
  </body>
</html>
