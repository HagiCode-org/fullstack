---
import { getCollection, render } from 'astro:content';
import { CourseBreadcrumb } from '@/components/course/CourseBreadcrumb';
import { CourseCard } from '@/components/course/CourseCard';
import { HomeSlogan } from '@/components/course/HomeSlogan';
import { HomeSteps } from '@/components/course/HomeSteps';
import { LanguageBand } from '@/components/course/LanguageBand';
import { ContinueButton } from '@/components/course/ContinueButton';
import { Disclosure } from '@/components/course/Disclosure';
import { LessonNav } from '@/components/course/LessonNav';
import { MarkReadButton } from '@/components/course/MarkReadButton';
import { Notice } from '@/components/course/Notice';
import { OutlineTree } from '@/components/course/OutlineTree';
import { PageToc } from '@/components/course/PageToc';
import { ProgressSummary } from '@/components/course/ProgressSummary';
import { hookProps } from '@/components/course/hooks';
import ProgressRuntime from '@/components/ProgressRuntime.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/config/site';
import { courses, flattenLessons, getCourse } from '@/courses/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { uiStringsFor } from '@/i18n/ui';
import { formatText } from '@/lib/format';
import { selectLessonBody } from '@/lib/lessonBody';
import { neighbourLinks, previewSections, treeOf } from '@/lib/courseView';
import { buildProgressIsland } from '@/lib/progressIsland';
import { allRoutes, routePath, switchLocale, type Route } from '@/lib/routes';
import { LOCALE_NATIVE_NAMES, SUPPORTED_LOCALES } from '@/config/site';

// One page per route. The route model decides every path, so each locale gets the same set of pages.
export function getStaticPaths() {
  return allRoutes().map((route) => {
    const path = routePath(route).replace(/^\/|\/$/gu, '');
    return { params: { route: path === '' ? undefined : path }, props: { route } };
  });
}

const { route } = Astro.props as { route: Route };
const locale = route.locale;
const ui = uiStringsFor(locale);
const homeHref = routePath({ kind: 'home', locale });

const lessonEntries = await getCollection('lessons');
const bodies = new Map(lessonEntries.map((entry) => [entry.id, entry]));

const course = route.kind === 'home' ? undefined : getCourse(route.courseId);
if (route.kind !== 'home' && !course) throw new Error(`No course "${route.courseId}" for ${routePath(route)}`);
const courseTitle = course?.title[locale] ?? SITE_NAME;
const courseHref = course ? routePath({ kind: 'course', locale, courseId: course.id }) : homeHref;
const lessonCount = course ? flattenLessons(course.outline).length : 0;
const hrefFor = (lessonId: string) => routePath({ kind: 'lesson', locale, courseId: course?.id ?? '', lessonId });

const overview = course ? treeOf(course, locale, hrefFor) : [];
const firstLessonId = course ? flattenLessons(course.outline)[0]?.id : undefined;
const outlineLabels = {
  readText: ui.readLabel,
  unreadText: ui.unreadLabel,
  currentText: ui.currentLessonLabel,
  progressText: ui.progressText,
};

const lesson = route.kind === 'lesson' && course ? route : undefined;
const lessonNode = lesson && course ? flattenLessons(course.outline).find((item) => item.id === lesson.lessonId) : undefined;
const lessonTitle = lessonNode?.title[locale] ?? '';
const body = lesson ? selectLessonBody((id) => bodies.get(id), lesson.courseId, lesson.lessonId, locale) : null;
const rendered = body ? await render(body.body) : null;
const headings = rendered?.headings ?? [];
const hasToc = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
const links = lesson && course ? neighbourLinks(course, locale, lesson.lessonId, hrefFor, { previous: ui.previousLabel, next: ui.nextLabel }) : null;
const back = { href: courseHref, caption: ui.backToCourseLabel, title: courseTitle };

const pageTitle = lesson ? `${lessonTitle} | ${courseTitle}` : courseTitle;
const island = buildProgressIsland(locale, { courseId: course?.id, lessonId: lesson?.lessonId });
---

{route.kind === 'home' && (
  <BaseLayout title={`${SITE_NAME}: ${ui.homeSloganLead}${ui.homeSloganHero}`} description={SITE_DESCRIPTION} route={route} width="wide">
    <div class="flex flex-col gap-12 lg:gap-16">
      <header class="grid gap-10 border-b pb-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-x-8 lg:pb-14">
        <HomeSlogan lead={ui.homeSloganLead} hero={ui.homeSloganHero} sub={ui.homeSloganSub} purpose={ui.homePurpose} />
        <HomeSteps heading={ui.homeStepsHeading} steps={[ui.homeStep1, ui.homeStep2, ui.homeStep3, ui.homeStep4]} />
      </header>
      <section aria-labelledby="home-courses-heading" class="flex flex-col gap-6">
        <h2 id="home-courses-heading" class="m-0 text-lg leading-snug font-semibold text-foreground">{ui.coursesHeading}</h2>
        <ul class="m-0 flex list-none flex-col gap-4 p-0">
          {courses.map((item) => {
            const total = flattenLessons(item.outline).length;
            const first = flattenLessons(item.outline)[0]?.id ?? '';
            const lessonHref = (lessonId: string) => routePath({ kind: 'lesson', locale, courseId: item.id, lessonId });
            const preview = previewSections(item, locale, lessonHref, 8);
            return (
              <li>
                <CourseCard
                  courseId={item.id}
                  title={item.title[locale]}
                  overviewHref={routePath({ kind: 'course', locale, courseId: item.id })}
                  demo={item.demo}
                  demoLabel={ui.demoLabel}
                  lessonCountText={formatText(ui.lessonCountText, { total })}
                  progressText={ui.progressText}
                  total={total}
                  continueHref={lessonHref(first)}
                  continueLabel={ui.startLabel}
                  sections={preview.sections}
                  fullOutlineLabel={preview.truncated ? ui.fullOutlineLabel : undefined}
                  readText={ui.readLabel}
                  unreadText={ui.unreadLabel}
                />
              </li>
            );
          })}
        </ul>
      </section>
      <LanguageBand
        heading={ui.languagesHeading}
        items={SUPPORTED_LOCALES.map((code) => ({
          id: code,
          label: LOCALE_NATIVE_NAMES[code],
          href: routePath(switchLocale(route, code)),
          current: code === locale,
        }))}
      />
    </div>
    <ProgressRuntime island={island} />
  </BaseLayout>
)}

{route.kind === 'course' && course && (
  <BaseLayout title={pageTitle} description={SITE_DESCRIPTION} route={route} width="medium">
    <CourseBreadcrumb items={[{ label: ui.siteHome, href: homeHref }, { label: courseTitle }]} label={ui.breadcrumbLabel} />
    <h1 style={`view-transition-name: course-${course.id}`}>{courseTitle}</h1>
    <div class="mb-8 flex max-w-md flex-col gap-4">
      <ProgressSummary courseId={course.id} total={lessonCount} progressText={ui.progressText} />
      <p class="m-0 text-foreground" hidden {...hookProps('courseComplete')} {...hookProps('courseId', course.id)}>
        {ui.completeText}
      </p>
      <ContinueButton courseId={course.id} href={routePath({ kind: 'lesson', locale, courseId: course.id, lessonId: firstLessonId ?? '' })} label={ui.startLabel} />
    </div>
    <OutlineTree courseId={course.id} nodes={overview} labels={outlineLabels} />
    <ProgressRuntime island={island} />
  </BaseLayout>
)}

{lesson && course && body && links && rendered && (
  <BaseLayout title={pageTitle} description={SITE_DESCRIPTION} route={route}>
    <Fragment slot="sidebar">
      <Disclosure id="course-outline" summary={ui.outlineLabel}>
        <div class="flex flex-col gap-4">
          <ProgressSummary courseId={course.id} total={lessonCount} progressText={ui.progressText} compact />
          <OutlineTree courseId={course.id} nodes={overview} currentLessonId={lesson.lessonId} labels={outlineLabels} />
        </div>
      </Disclosure>
    </Fragment>
    {hasToc && (
      <Fragment slot="rail">
        <PageToc headings={headings} label={ui.onThisPageLabel} />
      </Fragment>
    )}
    <article class="min-w-0 3xl:text-[1.125rem]">
      <CourseBreadcrumb
        items={[
          { label: ui.siteHome, href: homeHref },
          { label: courseTitle, href: courseHref },
          { label: lessonTitle },
        ]}
        label={ui.breadcrumbLabel}
      />
      <h1>{lessonTitle}</h1>
      {body.fallback && <Notice>{ui.fallbackNotice}</Notice>}
      <div class="lesson-content mt-6 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:scroll-mt-16 [&_h2]:text-2xl [&_h2]:leading-snug [&_h2]:font-semibold [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:scroll-mt-16 [&_h3]:text-lg [&_h3]:leading-snug [&_h3]:font-semibold [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6">
        {rendered && <rendered.Content />}
      </div>
      <div aria-hidden="true" class="h-px" {...hookProps('lessonEnd')} />
      <div class="mt-8 flex flex-col gap-4">
        <MarkReadButton courseId={course.id} lessonId={lesson.lessonId} markReadLabel={ui.markReadLabel} />
        <LessonNav previous={links.previous ?? undefined} next={links.next ?? undefined} back={back} />
      </div>
    </article>
    <ProgressRuntime island={island} />
  </BaseLayout>
)}
